{
  "name": "auto-job-application-assistant",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "dev": "npm run dev:server & npm run dev:client",
    "build:server": "npm run build -w server",
    "build:client": "npm run build -w client",
    "build": "npm run build:server && npm run build:client",
    "start": "npm run start -w server",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "ingest": "npm run ingest -w server",
    "replit": "npm install && npm run build && npm run db:migrate && npm run db:seed && npm run start"
  }
}

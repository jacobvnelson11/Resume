# Postgres connection string (docker-compose default shown; swap for Replit/Neon/etc. in prod)
DATABASE_URL=postgres://jobassistant:jobassistant@localhost:5432/jobassistant

# Anthropic API key for resume/cover-letter tailoring. NEVER commit a real key.
ANTHROPIC_API_KEY=

# Model used for tailoring generation
ANTHROPIC_MODEL=claude-sonnet-5

# Server port
PORT=8787

# Comma-separated list of Greenhouse board tokens to pull from, e.g. "gitlab,doist,zapier"
# Find a company's token in its careers page URL: boards.greenhouse.io/<token>
GREENHOUSE_BOARD_TOKENS=

# Minimum salary floor (annual, USD) - hard filter per PRD section 4
SALARY_MIN=60000

# How often (in minutes) the scheduled ingestion job runs
INGEST_INTERVAL_MINUTES=180

# How many jobs the once-a-day auto-agent generates resumes/cover letters for
DAILY_BATCH_SIZE=40

# What hour (0-23, server time) the daily auto-agent runs at
DAILY_BATCH_HOUR=7

# Simple single-user password gate for the web app (leave blank to disable in local dev)
APP_PASSWORD=

# Optional: session secret for the password-gate cookie
SESSION_SECRET=change-me-in-prod
